{
  "manifest_version": 3,
  "name": "Pipeline Warning",
  "version": "2.0.0",
  "description": "Проигрывает звук и показывает гифку, когда на странице GitLab появляется выбранный элемент.",
  "minimum_chrome_version": "116",
  "permissions": ["offscreen", "storage", "unlimitedStorage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pipeline Warning"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://code.nkz.icdc.io/*/-/pipelines",
        "https://code.nkz.icdc.io/*/-/pipelines?*"
      ],
      "js": ["keep-polling.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://code.nkz.icdc.io/*"],
      "js": ["content.js", "picker.js"],
      "run_at": "document_idle"
    }
  ]
}
